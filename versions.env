# Версии инструментов. Одно место на весь пайплайн: отсюда их берёт и Dockerfile
# (через ARG), и запасной путь через uvx при локальном запуске без образа.
#
# Закреплены не из осторожности, а потому что состав находок зависит от версии
# сканера. Плавающая версия даёт скачок в дашборде на ровном месте, и его
# разбирают как настоящий регресс. Обновление — отдельный коммит: sh ci/bump.sh
SEC_PYTHON=3.12

BANDIT_VERSION=1.9.4
SEMGREP_VERSION=1.176.1
RUFF_VERSION=0.16.6
PIP_AUDIT_VERSION=2.10.1
CHECKOV_VERSION=3.3.16

TRIVY_VERSION=0.74.0
GITLEAKS_VERSION=8.30.1
HADOLINT_VERSION=2.15.1
